# Copy to .env for Node loopback development. Never commit real values.
PORT=8787
# Without a TypeSafe key the game uses a labeled local deterministic opponent.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Optional development-guild command registration; omit for global registration.
DISCORD_TEST_GUILD_ID=
# Worker deployment uses secret bindings, not this file.
QUOTA_SALT=
ANALYTICS_ADMIN_TOKEN=
MAX_STARTS_PER_HOUR=2000
MAX_PROVIDER_ATTEMPTS_PER_DAY=10000
