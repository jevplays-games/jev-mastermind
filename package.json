{
  "name": "jev-mastermind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vanilla Mastermind duel, server authority, Discord context, structured JEV decisions and exhaustive deduction analytics.",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "start": "node --env-file-if-exists=.env server/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:exhaustive": "node tests/exhaustive.mjs",
    "test:browser": "playwright test",
    "bench:smoke": "node bench/run.mjs --secrets=16",
    "bench:exhaustive": "node bench/run.mjs --exhaustive",
    "verify": "node scripts/verify-replay.mjs",
    "dev:worker": "wrangler dev",
    "db:local": "wrangler d1 migrations apply mastermind --local",
    "db:remote": "wrangler d1 migrations apply mastermind --remote",
    "deploy": "wrangler deploy",
    "discord:register": "node scripts/register-commands.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "wrangler": "4.68.0"
  }
}
